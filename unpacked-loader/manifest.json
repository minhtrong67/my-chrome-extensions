{
  "manifest_version": 3,
  "name": "Unpacked Loader",
  "version": "1.0.0",
  "description": "Scan a folder of unpacked extensions, load them in bulk (launch script or guided queue), and reload them all at once.",
  "permissions": [
    "management",
    "storage",
    "clipboardWrite",
    "offscreen"
  ],
  "action": {
    "default_title": "Unpacked Loader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}