{
  "manifest_version": 3,
  "name": "Responsive Tester",
  "version": "1.0.0",
  "description": "Open any page you are viewing in a phone, tablet or desktop frame right on the tab. 80+ devices, compare mode, screenshots and recording.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open in Responsive Tester",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "agent.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "open-simulator": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the current page in Responsive Tester"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "css/app.css",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}