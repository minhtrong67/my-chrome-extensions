{
  "manifest_version": 3,
  "name": "Video Downloader",
  "version": "1.2.0",
  "description": "Download videos from most websites with one click on the floating download button.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "downloads",
    "offscreen",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/icons.js",
        "shared/core.js",
        "shared/theme.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "pagebridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "pagehook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}