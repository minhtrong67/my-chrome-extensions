{
  "manifest_version": 3,
  "name": "Discord Image Downloader",
  "version": "1.0.4",
  "description": "Add “Download all images” to Discord's message context menu. Fluent design.",
  "minimum_chrome_version": "111",
  "permissions": ["downloads", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Discord Image Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["shared/common.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
