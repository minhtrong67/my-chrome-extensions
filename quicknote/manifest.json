{
  "manifest_version": 3,
  "name": "QuickNote",
  "version": "3.0.0",
  "description": "Ghi chú nhanh, riêng tư, giao diện Material Design 3 | Fast, private notes with a Material Design 3 interface.",
  "author": "minhtrong67",
  "homepage_url": "https://github.com/minhtrong67",
  "minimum_chrome_version": "105",

  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickNote",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },

  "options_ui": { "page": "options.html", "open_in_tab": false },

  "permissions": ["storage", "unlimitedStorage"],

  "sandbox": { "pages": ["landing.html"] },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox; script-src 'self' 'unsafe-inline'; object-src 'self'"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "Open QuickNote"
    }
  }
}
