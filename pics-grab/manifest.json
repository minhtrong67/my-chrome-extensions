{
  "manifest_version": 3,
  "name": "Pics Grab – Bulk Image Downloader",
  "short_name": "Pics Grab",
  "version": "3.0.0",
  "description": "Scan any webpage and save many images at once. Hide logos, filter by format, convert to JPG and choose exactly where files go.",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pics Grab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "111"
}
