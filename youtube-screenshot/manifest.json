{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "TubeShot",
  "description": "__MSG_extDescription__",
  "version": "1.1.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeShot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "downloads", "scripting"],
  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
  "sandbox": {
    "pages": ["index.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox; script-src 'self' 'unsafe-inline'; object-src 'self'"
  }
}
